<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The parser predates nullable reference types; enabling it yields 40 warnings. -->
    <Nullable>disable</Nullable>
    
    <!-- Add this line to disable default compile items -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.9.2" />
    <PackageReference Include="Basic.Reference.Assemblies.Net80" Version="1.7.5" />
    <!-- Now you must explicitly include CSharpCodeParser.cs because we disabled defaults -->
    <Compile Include="CSharpCodeParser.cs" />
  </ItemGroup>

</Project>